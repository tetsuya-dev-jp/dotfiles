case $- in
  *i*) ;;
  *) return ;;
esac

[[ -f "$HOME/.config/shell/path.sh" ]] && . "$HOME/.config/shell/path.sh"
[[ -f "$HOME/.config/shell/environment.sh" ]] && . "$HOME/.config/shell/environment.sh"
[[ -f "$HOME/.config/shell/aliases.sh" ]] && . "$HOME/.config/shell/aliases.sh"
[[ -f "$HOME/.config/shell/functions.sh" ]] && . "$HOME/.config/shell/functions.sh"
[[ -f "$HOME/.config/shell/bun.sh" ]] && . "$HOME/.config/shell/bun.sh"

if [[ -x "$HOME/.local/bin/mise" ]]; then
  eval "$("$HOME/.local/bin/mise" activate bash)"
fi
